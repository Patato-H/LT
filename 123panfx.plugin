#!name = 123盘自动签到
#!version = 2.0
#!desc = 123分享社区(123panfx.com)每日自动签到。开启「抓取Cookie」后，用 Safari/浏览器登录网站并打开任意页面，经 MITM 解密读取 HTTPS 请求头中的 bbs_sid/bbs_token 自动保存(收到✅通知即成功)。开启「自动签到」后按 cron 定时执行，通知会显示版本、本次获得经验/金币、当前累计经验/金币(成功/已签/失效)。首次使用需信任 Loon 根证书并打开 MITM 总开关。
#!date = 2026-8-18
#!author = @Patatooo
#!icon = https://raw.githubusercontent.com/Patato-H/LT/main/123panfx/icon/panfx_icon_256.png
#!loon_version = 3.2.0(600)
#!tag = 签到, Cookie, 网盘, MITM

[Argument]
pf_cookie = switch,true,tag=抓取Cookie,desc=开启后，用 Safari/浏览器登录并打开 123panfx.com 任意页面，自动保存登录 Cookie(需已信任Loon证书)
pf_sign = switch,true,tag=自动签到,desc=按下方定时每天自动执行签到
pf_cron = input,"0 8 * * *",tag=签到cron,desc=自定义签到时间(Cron表达式,默认每天08:00)

[Script]
http-request ^https?:\/\/123panfx\.com script-path=https://raw.githubusercontent.com/Patato-H/LT/main/123panfx/panfx_cookie.js, requires-body=false, timeout=15, enable = {pf_cookie}, tag=123盘-Cookie
cron {pf_cron} script-path=https://raw.githubusercontent.com/Patato-H/LT/main/123panfx/panfx_signin.js, timeout=600, enable = {pf_sign}, tag=123盘-每日签到

[MITM]
hostname = 123panfx.com