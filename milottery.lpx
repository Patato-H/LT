#!name=小米抽奖
#!desc=小米商城「狂欢礼」抽奖助手：抓取 Cookie 与每日定时签到，两个功能独立开关，签到时间可自定义。开启「抓取Cookie」后进入小米商城 App 的抽奖活动页触发 Cookie 捕获（收到通知即成功）；开启「定时签到」后按自定义时间自动执行签到（默认为每天早上 7:30，可在插件面板随时修改执行时间）。
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png
#!tag=签到, 小米

[Argument]
milottery_cookie = switch,false,tag=抓取Cookie,desc=开启后进入小米商城 App「狂欢礼」抽奖活动页触发 Cookie 获取
milottery_cron = switch,false,tag=定时签到,desc=开启后按下方自定义时间自动执行小米抽奖签到，可随时修改
小米签到时间 = input,"30 7 * * *",tag=签到执行时间,desc=cron 表达式，默认每天早上7:30，可自行修改（如 0 21 * * * 为每晚9点）

[Script]
http-request ^https:\/\/shop-api\.retail\.mi\.com\/mtop\/navi\/venue\/batch tag=小米抽奖 Cookie, script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/milottery/milottery.js, requires-body=true, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png, enable={milottery_cookie}
cron {小米签到时间} script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/milottery/milottery.js, tag=小米抽奖签到, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/mishop.png, timeout=240, enable={milottery_cron}

[MITM]
hostname = shop-api.retail.mi.com