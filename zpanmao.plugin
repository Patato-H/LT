#!name = 追盘猫签到
#!version = 1.0
#!desc = 追盘猫(zpanmao.com,CloudSave Pro)每日自动签到领积分。开启「抓取Token」后，用 Safari/浏览器登录网站并打开任意页面，经 MITM 解密从请求头读取 Authorization: Bearer token 自动保存(收到✅通知即成功，token 更新自动同步)。开启「自动签到」后按 cron 定时执行，通知显示本次获得积分、当前余额、连续天数(成功/已签/失效)。
#!date = 2026-8-18
#!author = @Patatooo
#!icon = https://raw.githubusercontent.com/Patato-H/LT/main/zpanmao/icon/zpan_icon_256.png
#!loon_version = 3.2.0(600)
#!tag = 签到, Token, 网盘, MITM

[Argument]
zpan_cookie = switch,true,tag=抓取Token,desc=开启后，登录 zpanmao.com 并打开任意页面，自动保存登录 Token
zpan_sign = switch,true,tag=自动签到,desc=按下方定时每天自动执行签到
zpan_签到时间 = input,"0 8 * * *",tag=追盘猫签到时间,desc=自定义签到时间(Cron表达式,默认每天08:00)

[Script]
http-request ^https?:\/\/zpanmao\.com script-path=https://raw.githubusercontent.com/Patato-H/LT/main/zpanmao/zpan_cookie.js, requires-body=false, timeout=15, enable = {zpan_cookie}, tag=追盘猫-Token
cron {zpan_签到时间} script-path=https://raw.githubusercontent.com/Patato-H/LT/main/zpanmao/zpan_signin.js, timeout=600, enable = {zpan_sign}, tag=追盘猫-每日签到

[MITM]
hostname = zpanmao.com