[MITM]
hostname = %APPEND% creator.douyin.com

[Script]
http-request ^https?:\/\/creator\.douyin\.com tag=抖音Cookie抓取, script-path=https://raw.githubusercontent.com/Patato-H/LT/main/douyin/douyin_cookie.js
